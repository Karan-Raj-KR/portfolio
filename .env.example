# GitHub Personal Access Token (server-side only — never prefix with NEXT_PUBLIC_)
# Used by src/features/github/lib/github.ts to authenticate GitHub API requests.
# Create one at https://github.com/settings/tokens (read:user + public_repo scopes).
GITHUB_TOKEN=""

# Google Analytics 4 (GA4) Measurement ID
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""

# Google Search Console Verification Code
# Provide the code found in the <meta name="google-site-verification" content="..." /> tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
