---
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import MoreWork from '../../components/MoreWork.astro';
import How from '../../components/How.astro';
import FormWalk from '../../components/FormWalk.astro';
import { site, projects, type Project } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project, i) => ({ params: { slug: project.slug }, props: { project, i } }));
}
interface Props { project: Project; i: number }
const { project, i } = Astro.props;
const next = projects[(i + 1) % projects.length];
const isArticle = (href: string) => /hashnode|dev\.to|medium\.com/.test(href);
const sameAs = project.links.slice(1).map((l) => l.href).filter((h) => !isArticle(h));
const articles = project.links.map((l) => l.href).filter(isArticle);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  abstract: project.summary,
  genre: project.kind,
  dateCreated: String(project.year),
  keywords: project.stack.join(', '),
  creator: { '@id': new URL('/#person', Astro.site ?? site.url).href },
  ...(/Havinash|Saagnik/.test(project.team) ? { contributor: project.team.split(/,\s*|\s+and\s+/).filter((n) => n !== site.name).map((name) => ({ '@type': 'Person', name })) } : {}),
  ...(project.links[0] ? { url: project.links[0].href } : {}),
  ...(sameAs.length ? { sameAs } : {}),
  ...(articles.length ? { subjectOf: articles.map((url) => ({ '@type': 'Article', url })) } : {}),
};
const walk = project.how?.kind === 'steps' ? project.how : undefined;
const hasOutcome = project.outcome || project.facts || project.photo;
---
<Base title={project.title} seoTitle={`${project.title}: ${project.kind} | ${site.name}`} description={project.description} current="work" jsonLd={jsonLd}>
  <article class="case">
    <header class="case__hero" data-section="Case">
      <h1 class="case__title" style={`--chars: ${Math.max(10, ...project.title.split(/[\s-]+/).map((w) => w.length))}`}><span class="mask"><span class="rise"><span class="echo" data-ghost={project.title}>{project.title}</span></span></span></h1>
      <p class="case__summary rise-in">{project.summary}</p>
      {project.proof && <p class="case__proof rise-in">{project.proof}</p>}
      <dl class="case__meta facts facts--row rise-in">
        {project.serves && <div><dt>For</dt><dd>{project.serves}</dd></div>}
        {project.contribution ? <div class="case__mine"><dt>My part</dt><dd>{project.contribution}</dd></div> : <div><dt>Team</dt><dd>{project.team}</dd></div>}
        <div><dt>Built with</dt><dd>{project.stack.join(', ')}</dd></div>
      </dl>
      {project.links.length > 0 && (
        <ul class="case__links rise-in" aria-label={`${project.title} links`}>
          {project.links.map((l, k) => (
            <li><a class={`btn ${k === 0 ? 'btn--ink' : 'btn--tone'}`} href={l.href} rel="noopener" target="_blank"><span class="btn__fill" aria-hidden="true"></span><span class="btn__label">{l.label}</span><span class="btn__arrow" aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></li>
          ))}
        </ul>
      )}
    </header>

    {walk ? <FormWalk how={walk} /> : project.how && (
      <section class="case__how" data-section="How it works" aria-labelledby="how-title">
        <h2 class="sub-heading case__how-title" id="how-title">How it works</h2>
        <How how={project.how} size="case" />
      </section>
    )}

    <section class="case__pair" data-section="Context" aria-label="The problem and what it does">
      <div class="case__block">
        {project.sections.map((s) => (
          <div class="case__chapter">
            <h2 class="sub-heading" data-split="lines">{s.heading}</h2>
            <p class="case__idea">{s.text}</p>
          </div>
        ))}
      </div>
      {project.features && (
        <div class="case__block case__block--facts">
          <h2 class="sub-heading">What it does</h2>
          <ul class="features">{project.features.map((f) => <li>{f}</li>)}</ul>
        </div>
      )}
    </section>

    {project.decisions && (
      <section class="case__decisions" data-field="blue" data-section="Decisions" aria-labelledby="decisions-title">
        <h2 class="sr-only" id="decisions-title">Decisions</h2>
        {project.decisions.map((d) => (
          <div class="decision" data-reveal="up">
            <h3 class="decision__heading">{d.heading}</h3>
            <p class="decision__text">{d.text}</p>
          </div>
        ))}
      </section>
    )}

    {hasOutcome && (
      <section class="case__outcome" data-section="Outcome" aria-labelledby="outcome-title">
        <div class="case__outcome-copy">
          <h2 class="sub-heading" id="outcome-title">Outcome</h2>
          {project.outcome && <p class="case__outcome-text">{project.outcome}</p>}
          {project.facts && <dl class="facts">{project.facts.map((f) => <div><dt>{f.k}</dt><dd>{f.v}</dd></div>)}</dl>}
        </div>
        {project.photo && <div class="case__photo" data-reveal="lead"><Media media={project.photo} /></div>}
      </section>
    )}

    {project.links.length > 0 && (
      <section class="case__explore" aria-labelledby="explore-title">
        <h2 class="sub-heading" id="explore-title">Explore {project.title}</h2>
        <ul class="case__explore-list">
          {project.links.map((l) => (
            <li><a class="arrow-link" href={l.href} rel="noopener" target="_blank"><span class="arrow-link__label">{l.label}</span><span class="arrow-link__arrow" aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a><span class="case__explore-host">{new URL(l.href).hostname.replace(/^www\./, '')}</span></li>
          ))}
        </ul>
      </section>
    )}

    <nav class="next" aria-label="Next project" data-section="Next">
      <a class="next__link" href={`/work/${next.slug}/`} data-transition-label={next.title}>
        <span class="next__label">Next project</span>
        <span class="next__title">{next.title}<span class="next__arrow" aria-hidden="true">→</span></span>
        <span class="next__field">{next.line}</span>
      </a>
    </nav>
    <MoreWork exclude={[project.slug, next.slug]} heading="More work" />
  </article>
</Base>
